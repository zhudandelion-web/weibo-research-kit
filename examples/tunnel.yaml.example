config_version: 1
control_plane:
  api_key: file:/ABSOLUTE/PRIVATE/PATH/runtime.key
  base_url: https://api.openai.com
  tunnel_id: REPLACE_WITH_YOUR_TUNNEL_ID
mcp:
  commands:
    - channel: main
      command: /ABSOLUTE/PATH/.venv/bin/weibo-research serve
health:
  listen_addr: 127.0.0.1:0
  url_file: /ABSOLUTE/PRIVATE/PATH/weibo-health.url
log:
  level: info
  format: json
